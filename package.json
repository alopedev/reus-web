{
  "name": "reus-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p . && tsc -p api",
    "build": "tsc -p . && tsc -p api && vite build",
    "test": "node --import ./scripts/test/hooks.mjs --test 'scripts/test/*.test.ts' && python3 -m unittest discover -s scripts/test -p 'test_*.py'",
    "preview": "vite preview",
    "check": "npm test && npm run build && npm run build:paridad && python3 scripts/check.py",
    "build:paridad": "RED=./scripts/baseline/red.json OUT_DIR=../dist-paridad vite build",
    "check:datos": "python3 scripts/check_datos.py"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
