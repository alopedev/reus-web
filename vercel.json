{
  "regions": ["cdg1"],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "reus-web.vercel.app" }],
      "destination": "https://capacasa.alope.dev/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
